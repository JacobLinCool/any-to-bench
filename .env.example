# Copy this file to .env and fill in the keys for the provider(s) you use.
# .env is gitignored; the CLI loads it automatically (real env vars take precedence).

# For openai:* models (e.g. openai:gpt-5.6-sol)
OPENAI_API_KEY=

# For google:* models (e.g. google:gemini-3.7-flash)
GOOGLE_API_KEY=

# For google-cloud:* models — the same Google models over Vertex AI, reached with
# Google Cloud credentials instead of an API key. Point this at a service-account
# JSON key, or leave it unset to use `gcloud auth application-default login`.
GOOGLE_APPLICATION_CREDENTIALS=
# Only needed when the key belongs to one project and you want to bill another,
# or when using gcloud ADC rather than a key file.
GOOGLE_CLOUD_PROJECT=
# Optional; defaults to global, where new Gemini models land first.
GOOGLE_CLOUD_LOCATION=

# For codex:* agentic models (e.g. codex:gpt-5.6-sol) — optional; the Codex CLI's
# own `codex login` state is used when this is unset
CODEX_API_KEY=

# For claude:* agentic models (e.g. claude:opus) — optional; the Claude Code CLI's
# own login state is used when this is unset
ANTHROPIC_API_KEY=

# For `a2b upload` / private `a2b download` — optional; the `hf auth login`
# state is used when this is unset
HF_TOKEN=
