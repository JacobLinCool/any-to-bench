            },
            {
              "criterion_id": "maximum-distance",
              "points": 0.0,
              "rationale": "因邊向量符號不相容，算得各頂點距離平方最大為50，得最長距離 5√2，與正確答案 √94（AS=(6,7,-3)）不符。"
            }
